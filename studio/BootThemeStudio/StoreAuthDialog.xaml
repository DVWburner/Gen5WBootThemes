<Window x:Class="BootThemeStudio.StoreAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creator Account — market.ioniqthemes.com"
        Width="440" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Gen5W Store Creator Account" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Shared with Launcher Theme Studio — your existing account works across both tools."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,14">
            <Button x:Name="BtnTabSignIn" Content="Sign In" Click="BtnTabSignIn_Click"
                    Style="{StaticResource PrimaryCyanButton}" Margin="0,0,4,0" />
            <Button x:Name="BtnTabRegister" Content="Create New Account" Click="BtnTabRegister_Click"
                    Style="{StaticResource DarkButton}" Margin="4,0,0,0" />
        </UniformGrid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Account Username (private login handle, 3–32 chars)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="TxtUsername" MaxLength="32" Margin="0,0,0,12" />

            <TextBlock Text="Password (8–128 chars)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtPassword" MaxLength="128" Margin="0,0,0,12" />

            <StackPanel x:Name="PanelConfirmPassword" Visibility="Collapsed">
                <TextBlock Text="Confirm Password" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="TxtConfirmPassword" MaxLength="128" Margin="0,0,0,10" />
                <TextBlock Text="Note: Accounts do not use email; store your password safely as there is no password reset."
                           Foreground="{StaticResource AccentAmberBrush}" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="TxtError" Foreground="{StaticResource AccentRedBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Style="{StaticResource DarkButton}" Width="90" Margin="0,0,10,0" />
            <Button x:Name="BtnSubmit" Content="Sign In" Click="BtnSubmit_Click" Style="{StaticResource SuccessGreenButton}" Width="145" />
        </StackPanel>
    </Grid>
</Window>

<Application x:Class="BootThemeStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDeepBrush" Color="#FF0B1120" />
        <SolidColorBrush x:Key="BgPanelBrush" Color="#FF131D31" />
        <SolidColorBrush x:Key="BgCardBrush" Color="#FF1A263E" />
        <SolidColorBrush x:Key="BgInputBrush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FF2B3B59" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF38BDF8" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF10B981" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFF59E0B" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="#FFEF4444" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF94A3B8" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF243452" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FF384D74" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF30466D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryCyanButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FF0284C7" />
            <Setter Property="BorderBrush" Value="#FF38BDF8" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SuccessGreenButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FF059669" />
            <Setter Property="BorderBrush" Value="#FF34D399" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="DangerRedButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#FF991B1B" />
            <Setter Property="BorderBrush" Value="#FFF87171" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Resources>
</Application>

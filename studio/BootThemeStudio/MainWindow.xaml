<Window x:Class="BootThemeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gen5W Boot Theme Studio — Creator &amp; Store Uploader"
        Width="1260" Height="820" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Boot Theme Studio" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="New Theme" Click="BtnNew_Click" Style="{StaticResource DarkButton}" Margin="0,0,8,0" />
                    <Button Content="Open .zip..." Click="BtnOpenZip_Click" Style="{StaticResource DarkButton}" Margin="0,0,8,0" />
                    <Button Content="Prepare Car USB..." Click="BtnPrepareUsb_Click" Style="{StaticResource DarkButton}" Margin="0,0,8,0" />
                    <Button Content="Browse Online Store" Click="BtnBrowseStore_Click" Style="{StaticResource PrimaryCyanButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtAccountStatus" Text="Not signed in" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="BtnSignIn" Content="Sign In / Register" Click="BtnSignIn_Click" Style="{StaticResource PrimaryCyanButton}" />
                    <Button x:Name="BtnSignOut" Content="Sign Out" Click="BtnSignOut_Click" Style="{StaticResource DarkButton}" Visibility="Collapsed" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="385" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: METADATA & PARTS -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Theme Metadata" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                        <TextBlock Text="Theme Name *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtName" Text="My Gen5W Boot Theme" TextChanged="TxtName_TextChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Theme Slug ID * (auto-generated or custom)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtId" Text="my-gen5w-boot-theme" TextChanged="TxtId_TextChanged" Margin="0,0,0,10" />

                        <TextBlock Text="Creator Display Name (Public Author) *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtAuthor" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Version *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                                <TextBox x:Name="TxtVersion" Text="1.0.0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Revision *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                                <DockPanel>
                                    <Button Content="+1" DockPanel.Dock="Right" Click="BtnBumpRev_Click" Style="{StaticResource DarkButton}" Padding="8,4" Margin="4,0,0,0" />
                                    <TextBox x:Name="TxtRevision" Text="1" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Store Category *" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbCategory" Margin="0,0,0,10" Height="30" />

                        <TextBlock Text="Tags (comma-separated, optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtTags" Text="ioniq, gen5w" Margin="0,0,0,10" />

                        <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="Included Theme Parts" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkHasOnBoot" Content="Include Boot Image (1920×720 Static Splash)"
                                  IsChecked="True" Checked="PartToggle_Changed" Unchecked="PartToggle_Changed" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkHasPowerOff" Content="Include Goodbye / Start Video (1920×720 H.264)"
                                  IsChecked="True" Checked="PartToggle_Changed" Unchecked="PartToggle_Changed" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkSeparateWelcome" Content="Use a separate Door-Open Welcome Video"
                                  IsChecked="False" Checked="PartToggle_Changed" Unchecked="PartToggle_Changed" Margin="18,0,0,12" />

                        <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,10" />
                        <TextBlock x:Name="TxtEncoderInfo" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="Select Custom ffmpeg.exe (Optional)..." Click="BtnPickFfmpeg_Click"
                                Style="{StaticResource DarkButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4" FontSize="11.5" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: DUAL 8:3 LIVE EDITORS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- CARD 1: BOOT IMAGE -->
                <Border x:Name="CardOnBoot" Grid.Row="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="Black" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,14,0">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Border Width="960" Height="360" Background="Black">
                                        <Image x:Name="ImgBootPreview" Stretch="Fill" />
                                    </Border>
                                </Viewbox>
                                <TextBlock x:Name="TxtBootPlaceholder" Text="No Boot Image loaded (1920×720 8:3 Widescreen)"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="1. Boot Image (On Boot)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Content="Choose Image..." DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Click="BtnPickBootImage_Click" Style="{StaticResource PrimaryCyanButton}" />
                            </DockPanel>

                            <TextBlock Text="Framing Mode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbBootCropMode" SelectionChanged="BootCropControl_Changed" Margin="0,0,0,8">
                                <ComboBoxItem Content="Cover / Fill 1920×720 (Recommended)" IsSelected="True" />
                                <ComboBoxItem Content="Fit / Letterbox on Black" />
                            </ComboBox>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Horizontal Pan" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <Slider x:Name="SldPanX" Minimum="-1" Maximum="1" Value="0" ValueChanged="BootCropSlider_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Vertical Pan" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <Slider x:Name="SldPanY" Minimum="-1" Maximum="1" Value="0" ValueChanged="BootCropSlider_Changed" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock Text="Zoom" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <Button Content="Reset Crop" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Click="BtnResetCrop_Click" Style="{StaticResource DarkButton}" Padding="7,2" FontSize="11" />
                                </DockPanel>
                                <Slider x:Name="SldZoom" Minimum="1.0" Maximum="2.5" Value="1.0" ValueChanged="BootCropSlider_Changed" />
                            </StackPanel>

                            <TextBlock x:Name="TxtBootStats" Text="Outputs hardware-JPU Baseline 4:4:4 1920×720 + 1280×720 JPEGs (≤ 450 KB)."
                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 2: GOODBYE / WELCOME VIDEO -->
                <Border x:Name="CardPowerOff" Grid.Row="1" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="Black" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,14,0">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <Border Width="960" Height="360" Background="Black">
                                        <Grid>
                                            <Image x:Name="ImgVideoPoster" Stretch="Fill" />
                                            <MediaElement x:Name="MediaPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                          Stretch="Fill" IsMuted="True" MediaEnded="MediaPreview_MediaEnded" />
                                        </Grid>
                                    </Border>
                                </Viewbox>
                                <TextBlock x:Name="TxtVideoPlaceholder" Text="No Goodbye Video converted yet (1920×720 Silent H.264)"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="2. Goodbye Video (Power Off)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Content="Choose Video..." DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Click="BtnPickGoodbyeVideo_Click" Style="{StaticResource PrimaryCyanButton}" />
                            </DockPanel>

                            <TextBlock x:Name="TxtGoodbyeSource" Text="Source: (none)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                            <DockPanel x:Name="PanelWelcomePicker" Visibility="Collapsed" Margin="0,0,0,6">
                                <Button Content="Pick Welcome Video..." DockPanel.Dock="Right" Click="BtnPickWelcomeVideo_Click" Style="{StaticResource DarkButton}" Padding="8,3" FontSize="11.5" />
                                <TextBlock x:Name="TxtWelcomeSource" Text="Welcome: (none)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.45*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Framing Mode" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,2" />
                                    <ComboBox x:Name="CmbVideoCropMode" SelectionChanged="VideoCropControl_Changed">
                                        <ComboBoxItem Content="Cover / Fill 1920×720" IsSelected="True" />
                                        <ComboBoxItem Content="Fit / Letterbox on Black" />
                                    </ComboBox>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reset Video Pan" VerticalAlignment="Bottom"
                                        Click="BtnResetVideoPan_Click" Style="{StaticResource DarkButton}" Padding="7,4" FontSize="11" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Vertical Pan (Top ↔ Bottom)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <Slider x:Name="SldVideoPanY" Minimum="-1" Maximum="1" Value="0" ValueChanged="VideoPanSlider_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Horizontal Pan (Left ↔ Right)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <Slider x:Name="SldVideoPanX" Minimum="-1" Maximum="1" Value="0" ValueChanged="VideoPanSlider_Changed" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Trim Start (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <TextBox x:Name="TxtTrimStart" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="3,0">
                                    <TextBlock Text="Max Dur (s)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <TextBox x:Name="TxtMaxDuration" Text="10" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Poster Frame %" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />
                                    <TextBox x:Name="TxtPosterPct" Text="50" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="BtnConvertVideo" Content="Convert &amp; Build Previews" Click="BtnConvertVideo_Click"
                                        Style="{StaticResource SuccessGreenButton}" Margin="0,0,8,0" />
                                <Button Content="Play / Pause Preview" Click="BtnTogglePlay_Click" Style="{StaticResource DarkButton}" />
                            </WrapPanel>

                            <TextBlock x:Name="TxtVideoStats" Text="Converts any MP4/MOV/MKV/WEBM to silent 1920×720 H.264 + 960×360 GIF &amp; poster."
                                       Foreground="{StaticResource AccentGreenBrush}" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnExportZip" Content="Export Boot Theme .zip..." Click="BtnExportZip_Click"
                            Style="{StaticResource PrimaryCyanButton}" Padding="16,8" Margin="0,0,10,0" />
                    <Button x:Name="BtnUploadStore" Content="Upload to market.ioniqthemes.com" Click="BtnUploadStore_Click"
                            Style="{StaticResource SuccessGreenButton}" Padding="18,8" />
                </StackPanel>

                <TextBlock x:Name="TxtStatusBar" Text="Ready. Pick a Boot Image and/or Goodbye Video to build your Boot Theme."
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

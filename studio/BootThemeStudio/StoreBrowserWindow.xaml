<Window x:Class="BootThemeStudio.StoreBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boot Themes Store — market.ioniqthemes.com"
        Width="980" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CmbSort" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Newest" Tag="newest" IsSelected="True" />
                <ComboBoxItem Content="Popular" Tag="popular" />
            </ComboBox>

            <ComboBox x:Name="CmbCategory" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="Filter_Changed" />

            <ComboBox x:Name="CmbPart" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All Parts" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="Boot Image" Tag="onboot" />
                <ComboBoxItem Content="Goodbye Video" Tag="poweroff" />
                <ComboBoxItem Content="Combo (Both)" Tag="both" />
            </ComboBox>

            <TextBox x:Name="TxtSearch" Grid.Column="3" Margin="0,0,8,0" KeyDown="TxtSearch_KeyDown" />
            <Button Grid.Column="4" Content="Search / Refresh" Click="BtnRefresh_Click" Style="{StaticResource PrimaryCyanButton}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                <ListBox x:Name="LstItems" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         SelectionChanged="LstItems_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="2" Background="{StaticResource BgCardBrush}" CornerRadius="6">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding PartsBadge}" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource AccentCyanBrush}" FontSize="11.5" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding FriendlyMetaLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtDetailTitle" Text="Select a Boot Theme" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TxtDetailMeta" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtDetailDesc" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="Boot Image Preview" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <Border Height="125" Background="Black" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
                            <Image x:Name="ImgOnBootPreview" Stretch="Uniform" />
                        </Border>

                        <TextBlock Text="Goodbye Video Poster Preview" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,0,4" />
                        <Border Height="125" Background="Black" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                            <Image x:Name="ImgPowerOffPoster" Stretch="Uniform" />
                        </Border>

                        <WrapPanel>
                            <Button x:Name="BtnDownloadLoad" Content="Download &amp; Open in Studio"
                                    Click="BtnDownloadLoad_Click" Style="{StaticResource PrimaryCyanButton}"
                                    IsEnabled="False" Margin="0,0,8,8" />
                            <Button x:Name="BtnDeleteOwned" Content="Delete My Submission"
                                    Click="BtnDeleteOwned_Click" Style="{StaticResource DangerRedButton}"
                                    Visibility="Collapsed" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" Width="90"
                    Click="BtnClose_Click" Style="{StaticResource DarkButton}" />
        </DockPanel>
    </Grid>
</Window>
